{
  "version": 2,
  "builds": [
    { "src": "api/rpc.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/rpc", "methods": ["POST"], "dest": "/api/rpc.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.+)", "dest": "/public/$1" }
  ]
}
