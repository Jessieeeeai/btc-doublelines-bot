// AMD 识别 · 大漂亮 v1.1
// A区 = 吸筹横盘箱体; M区 = 操纵 (扫出箱体一侧); 破败信号 = 扫出后收盘收回箱体; D区 = 派发目标 (破败信号的 2~2.5R、4~4.5R)。
// 规则与 AMD马 机器人同一套 (箱体 12 根、高度 ≤ 3×ATR、扫出后 3 根内收回、止损 = 扫出的极值)。
// 一切只在 K 线收盘后判定, 画出来的东西不会事后消失或挪位置。
//@version=6
indicator("AMD 识别 · 大漂亮", shorttitle = "AMD", overlay = true, max_boxes_count = 300, max_lines_count = 300, max_labels_count = 300)

// ───────────── 常量 ─────────────
const string R_LEG   = "操纵腿: 箱体对侧 → 扫出的极值 (同 AMD马)"
const string R_TRADE = "止损距离: 进场价 → 止损"
const string G1 = "① A区 · 吸筹横盘"
const string G2 = "② M区 · 操纵与破败信号"
const string G3 = "③ D区 · 派发目标"
const string G4 = "④ 跟踪"
const string G5 = "⑤ 显示与提醒"

// ───────────── 参数 ─────────────
int    nBox   = input.int(12, "横盘根数", minval = 4, maxval = 60, group = G1, tooltip = "用信号K线之前的这么多根K线围成箱体 (A区)。AMD马 用的是 4 小时图 12 根。")
float  kAtr   = input.float(3.0, "箱体高度上限 (× ATR)", minval = 0.5, maxval = 10, step = 0.25, group = G1, tooltip = "箱体最高点减最低点不超过这么多倍 ATR 才算横盘。数越小要求越窄。")
int    atrLen = input.int(14, "ATR 周期", minval = 2, maxval = 100, group = G1, tooltip = "ATR 取箱体开始之前那一段, 不会被箱体自己的窄幅拉低。")

int    mBars  = input.int(3, "扫出后几根内必须收回", minval = 0, maxval = 10, group = G2, tooltip = "某根K线刺穿箱体一侧 (另一侧没破) 算扫出。扫出那根或之后这么多根内, 收盘回到箱体内 = 破败信号。超时作废。")
float  bufPct = input.float(0.03, "止损缓冲 (%)", minval = 0, maxval = 1, step = 0.01, group = G2, tooltip = "止损放在扫出的极值外面这么一点。")

string rMode  = input.string(R_LEG, "R 怎么量", options = [R_LEG, R_TRADE], group = G3, tooltip = "D区是破败信号的几倍。第一种: 1R = 箱体对侧到扫出极值的距离, 从箱体对侧起算 (AMD马 的算法)。第二种: 1R = 进场到止损的距离, 从进场价起算。")
float  d1a    = input.float(2.0, "D区一: 从", minval = 0.5, maxval = 20, step = 0.25, group = G3, inline = "d1")
float  d1b    = input.float(2.5, "到 (R)", minval = 0.5, maxval = 20, step = 0.25, group = G3, inline = "d1")
float  d2a    = input.float(4.0, "D区二: 从", minval = 0.5, maxval = 30, step = 0.25, group = G3, inline = "d2")
float  d2b    = input.float(4.5, "到 (R)", minval = 0.5, maxval = 30, step = 0.25, group = G3, inline = "d2")
float  minGap = input.float(0.3, "D区一离进场至少 (× 止损距离)", minval = 0, maxval = 5, step = 0.1, group = G3, tooltip = "D区一离进场价太近的信号不出 (没有空间)。填 0 = 不过滤。")

int    holdBars = input.int(48, "一单最多跟踪多少根", minval = 5, maxval = 500, group = G4)
float  beR      = input.float(0.2, "1R 到手后止损移到进场价外 (× 止损距离)", minval = 0, maxval = 1, step = 0.05, group = G4, tooltip = "第一止盈 (1R) 到手后, 止损线移到进场价外侧这么多。0 = 移到进场价。")
bool   oneLive  = input.bool(true, "同时只跟踪一单", group = G4, tooltip = "开: 上一单没走完时, 新的破败信号只打标记、不画目标 (和 AMD马 一样)。关: 新信号直接接管。")

bool   showFail = input.bool(false, "显示没等到破败信号的箱体", group = G5)
bool   showSkip = input.bool(false, "显示没跟踪的破败信号", group = G5, tooltip = "上一单没走完时出的破败信号。关: 不画。开: 画一个小灰标。")
bool   showTbl  = input.bool(true, "显示右上角统计", group = G5)
color  colA     = input.color(#2962FF, "A区", group = G5, inline = "c1")
color  colLong  = input.color(#089981, "多", group = G5, inline = "c1")
color  colShort = input.color(#F23645, "空", group = G5, inline = "c1")
color  colD     = input.color(#FF9800, "D区", group = G5, inline = "c1")

// ───────────── 每根都要算的序列 ─────────────
float boxHi  = ta.highest(high, nBox)[1]
float boxLo  = ta.lowest(low, nBox)[1]
float atrRef = ta.sma(ta.tr(true), atrLen)[nBox + 1]

f_reach(int dir, float lvl) => dir == 1 ? high >= lvl : low <= lvl
f_px(float x) => str.tostring(x, format.mintick)

// ───────────── 状态 ─────────────
// 等破败信号的箱体
var int   suSide = 0          // 1 = 扫了低点 (等做多), -1 = 扫了高点 (等做空), 0 = 没有
var float suLo   = na
var float suHi   = na
var float suExt  = na
var int   suBar  = na
var int   nextBar = 0
var box   suBox  = na
// 正在跟踪的一单
var bool  live  = false
var int   tDir  = 0
var int   tBar  = na
var float tE    = na
var float tSL   = na
var float tDist = na
var float tTP1  = na
var float tD1   = na
var float tD2   = na
var bool  hit1  = false
var bool  hitD1 = false
var line  lnE   = na
var line  lnSL  = na
var line  lnTP1 = na
var box   bxD1  = na
var box   bxD2  = na
// 统计
var int cSig = 0
var int cTP1 = 0
var int cD1  = 0
var int cD2  = 0
var int cSL  = 0

// 本根事件 (给提醒用)
bool evLong  = false
bool evShort = false
bool evTP1   = false
bool evD1    = false
bool evD2    = false
bool evStop  = false
float sgE  = na
float sgSL = na
float sgD1 = na
float sgD2 = na

if barstate.isconfirmed
    // ── 1. 先走已有的一单 (止损优先) ──
    if live and bar_index > tBar
        string endWhy = ""
        bool stopHit = tDir == 1 ? low <= tSL : high >= tSL
        if stopHit
            endWhy := hit1 ? "保护止损" : "止损"
            evStop := true
            if not hit1
                cSL += 1
        else
            if not hit1 and f_reach(tDir, tTP1)
                hit1 := true
                evTP1 := true
                cTP1 += 1
                tSL := tE - tDir * beR * tDist
                lnSL.set_y1(tSL)
                lnSL.set_y2(tSL)
                lnSL.set_x1(bar_index)
                label.new(bar_index, tTP1, "1R ✓", style = tDir == 1 ? label.style_label_down : label.style_label_up, color = color.new(tDir == 1 ? colLong : colShort, 20), textcolor = color.white, size = size.tiny)
            if not hitD1 and f_reach(tDir, tD1)
                hitD1 := true
                evD1 := true
                cD1 += 1
                bxD1.set_bgcolor(color.new(colD, 55))
            if f_reach(tDir, tD2)
                evD2 := true
                cD2 += 1
                bxD2.set_bgcolor(color.new(colD, 55))
                endWhy := "D区二到达"
            else if bar_index - tBar >= holdBars
                endWhy := "到时"
        lnE.set_x2(bar_index)
        lnSL.set_x2(bar_index)
        lnTP1.set_x2(bar_index)
        bxD1.set_right(bar_index)
        bxD2.set_right(bar_index)
        if endWhy != ""
            live := false
            label.new(bar_index, tDir == 1 ? high : low, endWhy, style = tDir == 1 ? label.style_label_down : label.style_label_up, color = color.new(color.gray, 30), textcolor = color.white, size = size.tiny)

    // ── 2. 找新的 A区 + 扫出 ──
    if suSide == 0 and bar_index >= nextBar and not na(atrRef) and boxHi - boxLo <= kAtr * atrRef
        bool dn = low < boxLo and high <= boxHi
        bool up = high > boxHi and low >= boxLo
        if dn or up
            suSide := dn ? 1 : -1
            suLo := boxLo
            suHi := boxHi
            suExt := dn ? low : high
            suBar := bar_index
            suBox := box.new(bar_index - nBox, boxHi, bar_index, boxLo, border_color = color.new(colA, 30), bgcolor = color.new(colA, 88), text = "A", text_color = color.new(colA, 0), text_size = size.small, text_halign = text.align_left, text_valign = text.align_top)

    // ── 3. 等破败信号 ──
    if suSide != 0
        suExt := suSide == 1 ? math.min(suExt, low) : math.max(suExt, high)
        suBox.set_right(bar_index)
        bool back = suSide == 1 ? close > suLo : close < suHi
        if back
            float e    = close
            float sl   = suExt * (1 - suSide * bufPct / 100)
            float dist = (e - sl) * suSide
            float far  = suSide == 1 ? suHi : suLo
            float leg  = (far - suExt) * suSide
            float base = rMode == R_LEG ? far : e
            float r    = rMode == R_LEG ? leg : dist
            float z1   = base + suSide * d1a * r
            bool  good = dist > 0 and (z1 - e) * suSide >= minGap * dist
            color c    = suSide == 1 ? colLong : colShort
            // M区: 从被扫的箱体边到扫出的极值
            if not live or not oneLive or showSkip
                box.new(suBar - 1, suSide == 1 ? suLo : suExt, bar_index, suSide == 1 ? suExt : suHi, border_color = color.new(c, 40), bgcolor = color.new(c, 85), text = "M", text_color = c, text_size = size.small, text_halign = text.align_right, text_valign = suSide == 1 ? text.align_bottom : text.align_top)
            else
                suBox.delete()
            if good
                bool track = not live or not oneLive
                string tip = (suSide == 1 ? "破败信号 · 多" : "破败信号 · 空") + "\n进场 " + f_px(e) + "\n止损 " + f_px(sl) + "\n1R " + f_px(e + suSide * dist) + "\nD区一 " + f_px(z1) + " ~ " + f_px(base + suSide * d1b * r) + "\nD区二 " + f_px(base + suSide * d2a * r) + " ~ " + f_px(base + suSide * d2b * r)
                if track
                    label.new(bar_index, suSide == 1 ? low : high, suSide == 1 ? "破败·多" : "破败·空", style = suSide == 1 ? label.style_label_up : label.style_label_down, color = color.new(c, 10), textcolor = color.white, size = size.small, tooltip = tip)
                else if showSkip
                    label.new(bar_index, suSide == 1 ? low : high, "·", style = suSide == 1 ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 50), textcolor = color.white, size = size.tiny, tooltip = tip + "\n(上一单未走完, 不跟踪)")
                if track
                    cSig += 1
                    sgE  := e
                    sgSL := sl
                    sgD1 := z1
                    sgD2 := base + suSide * d2a * r
                    if suSide == 1
                        evLong := true
                    else
                        evShort := true
                    live  := true
                    tDir  := suSide
                    tBar  := bar_index
                    tE    := e
                    tSL   := sl
                    tDist := dist
                    tTP1  := e + suSide * dist
                    tD1   := z1
                    tD2   := base + suSide * d2a * r
                    hit1  := false
                    hitD1 := false
                    lnE   := line.new(bar_index, e, bar_index + 1, e, color = color.new(color.gray, 20), style = line.style_dotted, width = 1)
                    lnSL  := line.new(bar_index, sl, bar_index + 1, sl, color = colShort, style = line.style_solid, width = 2)
                    lnTP1 := line.new(bar_index, tTP1, bar_index + 1, tTP1, color = color.new(colLong, 20), style = line.style_dashed, width = 1)
                    bxD1  := box.new(bar_index, math.max(z1, base + suSide * d1b * r), bar_index + 1, math.min(z1, base + suSide * d1b * r), border_color = color.new(colD, 30), bgcolor = color.new(colD, 85),
                         text = "D区一 " + str.tostring(d1a) + "~" + str.tostring(d1b) + "R", text_color = colD, text_size = size.small, text_halign = text.align_left)
                    bxD2  := box.new(bar_index, math.max(tD2, base + suSide * d2b * r), bar_index + 1, math.min(tD2, base + suSide * d2b * r), border_color = color.new(colD, 30), bgcolor = color.new(colD, 85),
                         text = "D区二 " + str.tostring(d2a) + "~" + str.tostring(d2b) + "R", text_color = colD, text_size = size.small, text_halign = text.align_left)
            else
                if showSkip
                    label.new(bar_index, suSide == 1 ? low : high, "D区一太近", style = suSide == 1 ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny)
            suSide := 0
            nextBar := bar_index + 1
        else if bar_index >= suBar + mBars
            if showFail
                suBox.set_border_color(color.new(color.gray, 50))
                suBox.set_bgcolor(color.new(color.gray, 92))
                suBox.set_text("A · 未收回")
                suBox.set_text_color(color.gray)
            else
                suBox.delete()
            suSide := 0
            nextBar := bar_index + 1

    // ── 4. 提醒: 每根收盘最多一条, 用「任何 alert() 函数调用」创建 ──
    string msg = ""
    if evLong
        msg += "破败信号·多 进 " + f_px(sgE) + " 损 " + f_px(sgSL) + " D区一 " + f_px(sgD1) + " D区二 " + f_px(sgD2) + "; "
    if evShort
        msg += "破败信号·空 进 " + f_px(sgE) + " 损 " + f_px(sgSL) + " D区一 " + f_px(sgD1) + " D区二 " + f_px(sgD2) + "; "
    if evTP1
        msg += "1R 到手, 止损移到 " + f_px(tSL) + "; "
    if evD1
        msg += "到达 D区一; "
    if evD2
        msg += "到达 D区二; "
    if evStop
        msg += "打到止损; "
    if msg != ""
        alert("AMD " + syminfo.ticker + " " + timeframe.period + ": " + msg, alert.freq_once_per_bar_close)

// ───────────── 统计表 ─────────────
var table tb = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 35), border_width = 1, border_color = color.new(color.gray, 60))
if barstate.islast and showTbl
    table.cell(tb, 0, 0, "AMD 识别", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, str.tostring(nBox) + " 根 · ≤" + str.tostring(kAtr) + "×ATR", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 1, "破败信号", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 1, str.tostring(cSig), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "到 1R", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 2, str.tostring(cTP1), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "到 D区一", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(cD1), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 4, "到 D区二", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 4, str.tostring(cD2), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 5, "没到 1R 就止损", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 5, str.tostring(cSL), text_color = color.white, text_size = size.small)

// ───────────── 单项提醒 (在提醒窗口里单独选) ─────────────
alertcondition(evLong,  "破败信号 · 多", "AMD 破败信号·多 {{ticker}} {{interval}} 收盘 {{close}}")
alertcondition(evShort, "破败信号 · 空", "AMD 破败信号·空 {{ticker}} {{interval}} 收盘 {{close}}")
alertcondition(evTP1,   "1R 到手",       "AMD 1R 到手 {{ticker}} {{interval}}")
alertcondition(evD1,    "到达 D区一",    "AMD 到达 D区一 {{ticker}} {{interval}}")
alertcondition(evD2,    "到达 D区二",    "AMD 到达 D区二 {{ticker}} {{interval}}")
alertcondition(evStop,  "打到止损",      "AMD 打到止损 {{ticker}} {{interval}}")
